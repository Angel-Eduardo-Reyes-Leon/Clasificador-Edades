# =============================================================================
# .gitignore - Qué NO subir al repositorio
# =============================================================================

# --- Datos pesados (NO subir a Git, usar Drive/S3) ---
data/raw/*
!data/raw/.gitkeep
data/images/*
!data/images/.gitkeep
data/partial_outputs/*
!data/partial_outputs/.gitkeep

# El manifest SÍ se sube (texto, ligero, garantiza reproducibilidad).
# Las features NO se suben (pueden pesar cientos de MB).
data/final/features.csv
data/final/images.zip
!data/final/manifest.csv
!data/final/.gitkeep

# --- Modelos entrenados (pesan, van a Drive/releases de GitHub) ---
models/*
!models/.gitkeep

# --- Reportes generados ---
reports/*
!reports/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
*.egg-info/
dist/
build/

# --- Jupyter ---
.ipynb_checkpoints/

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Logs y temporales ---
*.log
*.tmp
*.cache/
